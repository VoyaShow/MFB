<section class="section section--cream">
  <div class="page-width" style="max-width:480px">
    <h1>Choose a new password</h1>
    <div class="form-card">
      {% form 'reset_customer_password' %}
        {%- if form.errors -%}<div class="form-error">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label class="field"><span>New password</span><input type="password" name="customer[password]" required></label>
        <label class="field"><span>Confirm password</span><input type="password" name="customer[password_confirmation]" required></label>
        <button class="btn btn--full" type="submit">Save password</button>
      {% endform %}
    </div>
  </div>
</section>
