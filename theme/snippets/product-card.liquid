{%- liquid
  assign flag = card_flag | default: product.metafields.mfb.flag.value
  assign blurb = card_blurb | default: product.metafields.mfb.short_description.value | default: product.description | strip_html | truncatewords: 22
-%}
<article class="product-card" data-reveal>
  <a class="product-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: product.featured_image.alt | default: product.title, widths: '400,600,800' }}
    {%- else -%}
      <img src="{{ 'mfb-product-flower-box.png' | asset_url }}" alt="{{ product.title | escape }}" loading="lazy" width="800" height="800">
    {%- endif -%}
    {%- if flag != blank -%}
      <span class="pill pill--white product-card__flag">{{ flag }}</span>
    {%- endif -%}
  </a>
  <div class="product-card__body">
    <h3 class="product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <div class="product-card__price">
      {{ product.price | money }}
      {%- if product.compare_at_price > product.price -%}
        <s class="muted small">{{ product.compare_at_price | money }}</s>
      {%- endif -%}
    </div>
    <p class="product-card__desc">{{ blurb }}</p>
    <div class="product-card__cta">
      <a class="btn btn--sm" href="{{ product.url }}">Build this box</a>
    </div>
  </div>
</article>
