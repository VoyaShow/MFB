{%- liquid
  assign score = rating | default: 5 | times: 1
-%}
<span class="stars" role="img" aria-label="{{ score }} out of 5 stars">
  {%- for i in (1..5) -%}
    {%- if i <= score -%}
      {% render 'mfb-icon', icon: 'star' %}
    {%- else -%}
      <span style="opacity:.25">{% render 'mfb-icon', icon: 'star' %}</span>
    {%- endif -%}
  {%- endfor -%}
</span>
