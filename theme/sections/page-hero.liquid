<section class="section section--{{ section.settings.background }} section--tight">
  <div class="page-width">
    <div class="{% if section.settings.center %}center{% endif %}" style="{% if section.settings.center %}max-width:760px;margin:0 auto{% endif %}">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1>{{ section.settings.heading | default: page.title }}</h1>
      {%- if section.settings.text != blank -%}<div class="lede">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.cta_text != blank -%}
        <div class="cluster {% if section.settings.center %}cluster--center{% endif %}" style="margin-top:24px">
          <a class="btn" href="{{ section.settings.cta_link }}">{{ section.settings.cta_text }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Page hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta_text", "label": "Button label" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "checkbox", "id": "center", "label": "Centre the text", "default": true },
    { "type": "select", "id": "background", "label": "Background", "default": "blush",
      "options": [{ "value": "cream", "label": "Cream" }, { "value": "white", "label": "White" }, { "value": "blush", "label": "Blush" }, { "value": "mist", "label": "Mist" }, { "value": "sand", "label": "Sand" }, { "value": "meadow", "label": "Meadow" }, { "value": "peony", "label": "Peony" }] }
  ],
  "presets": [{ "name": "Page hero" }]
}
{% endschema %}
