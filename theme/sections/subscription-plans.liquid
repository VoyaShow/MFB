<section class="section section--{{ section.settings.background }}">
  <div class="page-width">
    {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, subheading: section.settings.subheading %}
    <div class="grid grid--{{ section.blocks.size | at_most: 4 }}">
      {%- for block in section.blocks -%}
        <div class="plan-card {% if block.settings.featured %}plan-card--featured{% endif %}" {{ block.shopify_attributes }} data-reveal>
          {%- if block.settings.featured -%}
            <span class="pill plan-card__flag">Most popular</span>
          {%- endif -%}
          <h3>{{ block.settings.name }}</h3>
          <div class="plan-card__price">{{ block.settings.price }}</div>
          <p class="muted small">{{ block.settings.cadence }}</p>
          <ul>
            {%- assign perks = block.settings.perks | newline_to_br | split: '<br />' -%}
            {%- for perk in perks -%}
              {%- assign clean = perk | strip -%}
              {%- if clean != blank -%}<li>{{ clean }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
          <a class="btn {% unless block.settings.featured %}btn--secondary{% endunless %} btn--full"
             href="{{ block.settings.link | default: '/collections/shop' }}">{{ block.settings.cta | default: 'Choose this plan' }}</a>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.footnote != blank -%}
      <p class="center muted" style="margin-top:30px">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Subscription plans",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Subscriptions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A surprise on repeat" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Pause, skip, upgrade or cancel yourself from your account — no emails, no phone calls.</p>" },
    { "type": "richtext", "id": "footnote", "label": "Footnote" },
    { "type": "select", "id": "background", "label": "Background", "default": "blush",
      "options": [{ "value": "cream", "label": "Cream" }, { "value": "white", "label": "White" }, { "value": "blush", "label": "Blush" }, { "value": "mist", "label": "Mist" }] }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Plan",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Fortnightly" },
        { "type": "text", "id": "price", "label": "Price", "default": "£35" },
        { "type": "text", "id": "cadence", "label": "Cadence", "default": "per box, every two weeks" },
        { "type": "textarea", "id": "perks", "label": "Perks (one per line)", "default": "Free UK delivery\nPause or skip any time\nDouble loyalty points\nFirst access to limited boxes" },
        { "type": "text", "id": "cta", "label": "Button label", "default": "Choose this plan" },
        { "type": "url", "id": "link", "label": "Button link" },
        { "type": "checkbox", "id": "featured", "label": "Highlight this plan", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Subscription plans" }]
}
{% endschema %}
