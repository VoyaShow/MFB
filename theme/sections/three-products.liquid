{%- assign coll = collections[section.settings.collection] -%}
<section class="section section--{{ section.settings.background }}">
  <div class="page-width">
    {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, subheading: section.settings.subheading %}
    <div class="grid grid--3">
      {%- if coll.products.size > 0 -%}
        {%- for product in coll.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <article class="product-card">
            <div class="product-card__media">
              <img src="{{ 'mfb-product-flower-box.png' | asset_url }}" alt="" width="800" height="800" loading="lazy">
            </div>
            <div class="product-card__body">
              <h3 class="product-card__title">Add your boxes</h3>
              <p class="product-card__desc">Pick a collection in the theme editor to show your three core products here.</p>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if section.settings.footnote != blank -%}
      <p class="center lede" style="margin-top:34px">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Three core products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Three clear choices" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One price. Three boxes. Endless surprises." },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>No endless bouquets to scroll through. Choose your box, tell us what to leave out, and let the growers do the rest.</p>" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 3, "max": 6, "step": 1, "label": "Products to show", "default": 3 },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "Every box is £35. Always." },
    { "type": "select", "id": "background", "label": "Background", "default": "white",
      "options": [{ "value": "cream", "label": "Cream" }, { "value": "white", "label": "White" }, { "value": "blush", "label": "Blush" }, { "value": "mist", "label": "Mist" }] }
  ],
  "presets": [{ "name": "Three core products" }]
}
{% endschema %}
