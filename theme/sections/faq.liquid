<section class="section section--{{ section.settings.background }}">
  <div class="page-width page-width--narrow">
    {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, subheading: section.settings.subheading %}
    <div class="accordion">
      {%- for block in section.blocks -%}
        <details class="accordion__item" {{ block.shopify_attributes }}>
          <summary class="accordion__summary">{{ block.settings.question }}</summary>
          <div class="accordion__body rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
    {%- if section.settings.cta_text != blank -%}
      <div class="cluster cluster--center" style="margin-top:36px">
        <a class="btn btn--secondary" href="{{ section.settings.cta_link }}">{{ section.settings.cta_text }}</a>
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "FAQ",
  "max_blocks": 24,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything you might want to ask" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "cta_text", "label": "Button label" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "select", "id": "background", "label": "Background", "default": "white",
      "options": [{ "value": "cream", "label": "Cream" }, { "value": "white", "label": "White" }, { "value": "blush", "label": "Blush" }, { "value": "mist", "label": "Mist" }] }
  ],
  "blocks": [
    { "type": "qa", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "Can I choose what is in my box?" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Not exactly — that is the whole point. You can tell us what to leave out though.</p>" }
    ] }
  ],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
