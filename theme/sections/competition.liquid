<section class="section section--{{ section.settings.background }}">
  <div class="page-width center">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <div class="lede" style="max-width:680px;margin:0 auto 30px">{{ section.settings.text }}</div>

    {%- if section.settings.closes_at != blank -%}
      <div class="countdown" data-countdown="{{ section.settings.closes_at }}">
        <div class="countdown__unit"><div class="countdown__num" data-unit="d">--</div><div class="countdown__label">Days</div></div>
        <div class="countdown__unit"><div class="countdown__num" data-unit="h">--</div><div class="countdown__label">Hours</div></div>
        <div class="countdown__unit"><div class="countdown__num" data-unit="m">--</div><div class="countdown__label">Mins</div></div>
        <div class="countdown__unit"><div class="countdown__num" data-unit="s">--</div><div class="countdown__label">Secs</div></div>
      </div>
    {%- endif -%}

    <div class="form-card" style="max-width:560px;margin:34px auto 0;text-align:left">
      {% form 'customer', id: 'competition-entry' %}
        {%- if form.posted_successfully? -%}
          <div class="form-success"><strong>You are in the draw. Good luck! 🎟️</strong><br>We will email the winner on the closing date.</div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="form-error">Please check the highlighted fields.</div>
          {%- endif -%}
          <input type="hidden" name="contact[tags]" value="competition,{{ section.settings.competition_tag }}">
          <label class="field"><span>First name</span><input type="text" name="contact[first_name]" required></label>
          <label class="field"><span>Email address</span><input type="email" name="contact[email]" required></label>
          <label class="field"><span>Where did you hear about us?</span>
            <select name="contact[note]">
              <option>In a supermarket</option>
              <option>A QR code on a box</option>
              <option>Instagram or TikTok</option>
              <option>A friend told me</option>
              <option>Somewhere else</option>
            </select>
          </label>
          <label class="field" style="display:flex;gap:10px;align-items:flex-start">
            <input type="checkbox" name="contact[accepts_marketing]" value="true" style="width:auto;margin-top:6px" required>
            <span style="margin:0;font-weight:400;font-size:.92rem">Yes, email me about competitions, new boxes and offers. You can unsubscribe at any time.</span>
          </label>
          <button class="btn btn--full" type="submit">{{ section.settings.cta_text }}</button>
          <p class="form-note">{{ section.settings.small_print }}</p>
        {%- endif -%}
      {% endform %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Competition",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "This month's competition" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Win a year of Mystery Flower Boxes" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>One winner, twelve months of surprises, zero effort. Enter once and you are in every monthly draw.</p>" },
    { "type": "text", "id": "closes_at", "label": "Closes at (YYYY-MM-DDTHH:MM:SS)", "default": "2026-12-31T23:59:59" },
    { "type": "text", "id": "competition_tag", "label": "Customer tag", "default": "comp-year-of-flowers" },
    { "type": "text", "id": "cta_text", "label": "Button label", "default": "Enter the draw" },
    { "type": "text", "id": "small_print", "label": "Small print", "default": "Open to UK residents 18+. No purchase necessary. Full terms on the competition page." },
    { "type": "select", "id": "background", "label": "Background", "default": "mist",
      "options": [{ "value": "cream", "label": "Cream" }, { "value": "white", "label": "White" }, { "value": "blush", "label": "Blush" }, { "value": "mist", "label": "Mist" }, { "value": "sand", "label": "Sand" }] }
  ],
  "presets": [{ "name": "Competition" }]
}
{% endschema %}
