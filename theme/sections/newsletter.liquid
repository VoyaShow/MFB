<section class="section section--{{ section.settings.background }} {% if section.settings.tight %}section--tight{% endif %}">
  <div class="page-width center">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <div class="lede" style="max-width:600px;margin:0 auto 26px">{{ section.settings.text }}</div>
    <div style="max-width:520px;margin:0 auto">
      {% form 'customer', id: 'mfb-newsletter' %}
        {%- if form.posted_successfully? -%}
          <div class="form-success"><strong>Welcome to the club.</strong> Your 10% code is on its way.</div>
        {%- else -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="inline-form">
            <input type="email" name="contact[email]" placeholder="you@example.com" aria-label="Email address" required>
            <button class="btn" type="submit">{{ section.settings.cta_text }}</button>
          </div>
          <p class="form-note">{{ section.settings.note }}</p>
        {%- endif -%}
      {% endform %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join 40,000 flower people" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "10% off your first surprise" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Golden Ticket news, limited boxes and flower care tips. One email a week, never more.</p>" },
    { "type": "text", "id": "cta_text", "label": "Button label", "default": "Send my code" },
    { "type": "text", "id": "note", "label": "Note", "default": "We look after your data. Unsubscribe in one click. See our privacy policy." },
    { "type": "checkbox", "id": "tight", "label": "Reduced padding", "default": false },
    { "type": "select", "id": "background", "label": "Background", "default": "blush",
      "options": [{ "value": "cream", "label": "Cream" }, { "value": "white", "label": "White" }, { "value": "blush", "label": "Blush" }, { "value": "mist", "label": "Mist" }, { "value": "peony", "label": "Peony" }] }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
