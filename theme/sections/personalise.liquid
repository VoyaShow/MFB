<section class="section section--{{ section.settings.background }}">
  <div class="page-width">
    <div class="split {% if section.settings.reverse %}split--reverse{% endif %}">
      <div class="split__media">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}" width="1200" height="1200" loading="lazy">
        {%- else -%}
          <img src="{{ 'mfb-product-flower-box-alt.png' | asset_url }}" alt="{{ section.settings.heading | escape }}" width="1400" height="1400" loading="lazy">
        {%- endif -%}
      </div>
      <div>
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <div class="lede">{{ section.settings.text }}</div>

        <div class="chips" style="margin:26px 0">
          {%- for block in section.blocks -%}
            <span class="chip" {{ block.shopify_attributes }}>
              <span class="chip__label" style="cursor:default">
                {%- if block.settings.swatch != blank -%}
                  <span class="chip__swatch" style="background:{{ block.settings.swatch }}"></span>
                {%- endif -%}
                {{ block.settings.text }}
                <span aria-hidden="true">✕</span>
              </span>
            </span>
          {%- endfor -%}
        </div>

        <a class="btn" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_text }}</a>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Your box, your rules",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Your box, your rules" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Keep the surprise. Lose the lilies." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>You don't choose what goes in — but you can tell us what to leave out. Allergic to lilies? Hate orange? Cat at home? Tick it on the box builder and our growers pack around it. Everything else stays a total mystery.</p>" },
    { "type": "text", "id": "cta_text", "label": "Button label", "default": "Build my box" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "reverse", "label": "Image on the right", "default": false },
    { "type": "select", "id": "background", "label": "Background", "default": "blush",
      "options": [{ "value": "cream", "label": "Cream" }, { "value": "white", "label": "White" }, { "value": "blush", "label": "Blush" }, { "value": "mist", "label": "Mist" }, { "value": "sand", "label": "Sand" }] }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Exclusion chip",
      "settings": [
        { "type": "text", "id": "text", "label": "Label", "default": "No lilies" },
        { "type": "text", "id": "swatch", "label": "Swatch colour (hex, optional)" }
      ]
    }
  ],
  "presets": [{ "name": "Your box, your rules" }]
}
{% endschema %}
