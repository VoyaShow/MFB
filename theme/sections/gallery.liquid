<section class="section section--{{ section.settings.background }}">
  <div class="page-width">
    {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, subheading: section.settings.subheading %}

    {%- if section.settings.show_filters -%}
      <div class="tabs" data-tabs="#mfb-gallery-grid">
        <button class="tab-btn" type="button" data-tab="all" aria-selected="true">Everything</button>
        {%- assign tabs = section.settings.filters | split: ',' -%}
        {%- for tab in tabs -%}
          <button class="tab-btn" type="button" data-tab="{{ tab | strip | handle }}" aria-selected="false">{{ tab | strip }}</button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="masonry" id="mfb-gallery-grid">
      {%- for block in section.blocks -%}
        {%- assign idx = forloop.index0 | modulo: 12 | plus: 1 -%}
        {%- capture fallback -%}mfb-gallery-{% if idx < 10 %}0{% endif %}{{ idx }}.svg{%- endcapture -%}
        <figure class="gallery-tile" data-tab-panel="{{ block.settings.category | handle }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.caption | escape }}" loading="lazy" width="900" height="900">
          {%- else -%}
            <img src="{{ fallback | asset_url }}" alt="{{ block.settings.caption | escape }}" loading="lazy" width="900" height="900">
          {%- endif -%}

          {%- if block.settings.product != blank -%}
            <a class="gallery-tile__shop" href="{{ block.settings.product.url | default: '#' }}">Shop this box</a>
          {%- endif -%}

          <figcaption class="gallery-tile__overlay">
            <span class="gallery-tile__who">{{ block.settings.name }}{% if block.settings.location != blank %}, {{ block.settings.location }}{% endif %}</span>
            {%- if block.settings.caption != blank -%}<div>{{ block.settings.caption }}</div>{%- endif -%}
            <div class="gallery-tile__actions">
              <button type="button" data-like="g-{{ block.id }}" aria-pressed="false" aria-label="Like this photo">
                {% render 'mfb-icon', icon: 'heart' %} <span data-like-count>{{ block.settings.likes }}</span>
              </button>
              <span>{% render 'mfb-icon', icon: 'comment' %} {{ block.settings.comments }}</span>
              <span>{{ block.settings.box_type }}</span>
            </div>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_text != blank -%}
      <div class="cluster cluster--center" style="margin-top:44px">
        <a class="btn" href="{{ section.settings.cta_link }}">{{ section.settings.cta_text }}</a>
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Customer gallery",
  "max_blocks": 36,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer gallery" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "#MysteryFlowerBox" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Real boxes, real homes, real reactions. Tag us and you could land on this wall — and in the Golden Ticket draw.</p>" },
    { "type": "checkbox", "id": "show_filters", "label": "Show category filters", "default": true },
    { "type": "text", "id": "filters", "label": "Filters (comma separated)", "default": "Unboxings, In the home, Occasions, Plants, Golden Tickets" },
    { "type": "text", "id": "cta_text", "label": "Button label", "default": "Upload your photo" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "select", "id": "background", "label": "Background", "default": "white",
      "options": [{ "value": "cream", "label": "Cream" }, { "value": "white", "label": "White" }, { "value": "blush", "label": "Blush" }, { "value": "mist", "label": "Mist" }] }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "name", "label": "Customer name", "default": "Jess" },
        { "type": "text", "id": "location", "label": "Location", "default": "Leeds" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Third box and still smiling" },
        { "type": "select", "id": "category", "label": "Category", "default": "Unboxings",
          "options": [
            { "value": "Unboxings", "label": "Unboxings" }, { "value": "In the home", "label": "In the home" },
            { "value": "Occasions", "label": "Occasions" }, { "value": "Plants", "label": "Plants" },
            { "value": "Golden Tickets", "label": "Golden Tickets" }
          ] },
        { "type": "text", "id": "box_type", "label": "Box type", "default": "Mystery Flower Box" },
        { "type": "text", "id": "likes", "label": "Likes", "default": "128" },
        { "type": "text", "id": "comments", "label": "Comments", "default": "12" },
        { "type": "product", "id": "product", "label": "Shop this box" }
      ]
    }
  ],
  "presets": [{ "name": "Customer gallery" }]
}
{% endschema %}
