<section class="section section--{{ section.settings.background }}">
  <div class="page-width">
    <div class="split">
      <div>
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <div class="lede">{{ section.settings.text }}</div>
        {%- if section.settings.cta_text != blank -%}
          <a class="btn btn--light" style="margin-top:24px" href="{{ section.settings.cta_link }}">{{ section.settings.cta_text }}</a>
        {%- endif -%}
      </div>
      <div class="stack">
        {%- for block in section.blocks -%}
          <div class="ticket-card" {{ block.shopify_attributes }}>
            <span class="ticket-card__icon" aria-hidden="true">{{ block.settings.emoji }}</span>
            <span>
              <strong>{{ block.settings.prize }}</strong>
              {{ block.settings.winner }}
            </span>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Golden Ticket tracker",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Golden Ticket tracker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One in every 250 boxes hides a Golden Ticket" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Free boxes for a year, weekend breaks, grower tours and limited-edition blooms. Winners announced here and in your inbox.</p>" },
    { "type": "text", "id": "cta_text", "label": "Button label", "default": "See the prize list" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "select", "id": "background", "label": "Background", "default": "peony",
      "options": [{ "value": "peony", "label": "Peony" }, { "value": "raspberry", "label": "Raspberry" }, { "value": "sand", "label": "Sand" }, { "value": "cream", "label": "Cream" }] }
  ],
  "blocks": [
    {
      "type": "winner",
      "name": "Winner",
      "settings": [
        { "type": "text", "id": "emoji", "label": "Emoji", "default": "🎟️" },
        { "type": "text", "id": "prize", "label": "Prize", "default": "A year of free boxes" },
        { "type": "text", "id": "winner", "label": "Winner", "default": "Dani, Bristol — last Friday" }
      ]
    }
  ],
  "presets": [{ "name": "Golden Ticket tracker" }]
}
{% endschema %}
