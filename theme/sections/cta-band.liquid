<section class="section section--{{ section.settings.background }} {% if section.settings.tight %}section--tight{% endif %}">
  <div class="page-width center">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<div class="lede" style="max-width:640px;margin:0 auto">{{ section.settings.text }}</div>{%- endif -%}
    <div class="cluster cluster--center" style="margin-top:28px">
      {%- if section.settings.cta_text != blank -%}
        <a class="btn btn--lg {% if section.settings.background == 'peony' or section.settings.background == 'raspberry' %}btn--light{% endif %}"
           href="{{ section.settings.cta_link | default: '/collections/shop' }}">{{ section.settings.cta_text }}</a>
      {%- endif -%}
      {%- if section.settings.cta2_text != blank -%}
        <a class="btn btn--ghost btn--lg" href="{{ section.settings.cta2_link }}"
           {% if section.settings.background == 'peony' or section.settings.background == 'raspberry' %}style="color:#fff;border-color:#fff"{% endif %}>{{ section.settings.cta2_text }}</a>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Call to action band",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready for a very good surprise?" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta_text", "label": "Primary button", "default": "Surprise Me!" },
    { "type": "url", "id": "cta_link", "label": "Primary link" },
    { "type": "text", "id": "cta2_text", "label": "Secondary button" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link" },
    { "type": "checkbox", "id": "tight", "label": "Reduced padding", "default": false },
    { "type": "select", "id": "background", "label": "Background", "default": "peony",
      "options": [{ "value": "peony", "label": "Peony" }, { "value": "raspberry", "label": "Raspberry" }, { "value": "cream", "label": "Cream" }, { "value": "blush", "label": "Blush" }, { "value": "white", "label": "White" }, { "value": "sand", "label": "Sand" }] }
  ],
  "presets": [{ "name": "Call to action band" }]
}
{% endschema %}
