<section class="section section--{{ section.settings.background }} section--tight">
  <div class="page-width">
    {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
    <div class="ig-grid">
      {%- for block in section.blocks -%}
        {%- assign idx = forloop.index0 | modulo: 12 | plus: 1 -%}
        {%- capture fallback -%}mfb-gallery-{% if idx < 10 %}0{% endif %}{{ idx }}.svg{%- endcapture -%}
        <a href="{{ block.settings.link | default: section.settings.profile_url }}" {{ block.shopify_attributes }}
           target="_blank" rel="noopener" aria-label="View post on Instagram">
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 400 }}" alt="" width="400" height="400" loading="lazy">
          {%- else -%}
            <img src="{{ fallback | asset_url }}" alt="" width="900" height="900" loading="lazy">
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
    <div class="cluster cluster--center" style="margin-top:26px">
      <a class="btn btn--secondary btn--sm" href="{{ section.settings.profile_url }}" target="_blank" rel="noopener">
        {% render 'mfb-icon', icon: 'instagram' %} {{ section.settings.handle }}
      </a>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Instagram feed",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Follow along" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "@mysteryflowerbox" },
    { "type": "text", "id": "handle", "label": "Handle", "default": "@mysteryflowerbox" },
    { "type": "url", "id": "profile_url", "label": "Profile URL" },
    { "type": "select", "id": "background", "label": "Background", "default": "cream",
      "options": [{ "value": "cream", "label": "Cream" }, { "value": "white", "label": "White" }, { "value": "blush", "label": "Blush" }] }
  ],
  "blocks": [
    { "type": "post", "name": "Post", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "url", "id": "link", "label": "Post link" }
    ] }
  ],
  "presets": [{ "name": "Instagram feed" }]
}
{% endschema %}
