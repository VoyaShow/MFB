<section class="section section--{{ section.settings.background }}">
  <div class="page-width">
    <div class="split {% if section.settings.reverse %}split--reverse{% endif %}">
      <div class="split__media">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}" width="1200" height="1200" loading="lazy">
        {%- else -%}
          <img src="{{ 'mfb-gallery-02.svg' | asset_url }}" alt="" width="900" height="900" loading="lazy">
        {%- endif -%}
      </div>
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <div class="rte">{{ section.settings.text }}</div>
        {%- if section.settings.cta_text != blank -%}
          <a class="btn" style="margin-top:22px" href="{{ section.settings.cta_link }}">{{ section.settings.cta_text }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A heading about the box" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Supporting copy goes here.</p>" },
    { "type": "text", "id": "cta_text", "label": "Button label" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "checkbox", "id": "reverse", "label": "Image on the right", "default": false },
    { "type": "select", "id": "background", "label": "Background", "default": "white",
      "options": [{ "value": "cream", "label": "Cream" }, { "value": "white", "label": "White" }, { "value": "blush", "label": "Blush" }, { "value": "mist", "label": "Mist" }, { "value": "sand", "label": "Sand" }, { "value": "meadow", "label": "Meadow" }] }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
