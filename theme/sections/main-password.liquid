<section class="section section--blush" style="min-height:100vh;display:grid;place-items:center">
  <div class="page-width center" style="max-width:560px">
    <img src="{{ 'mfb-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="420" height="204" style="margin:0 auto 26px;max-width:280px">
    <h1>{{ section.settings.heading }}</h1>
    <p class="lede">{{ section.settings.text }}</p>

    <div class="form-card" style="margin-top:26px;text-align:left">
      {% form 'customer', id: 'password-signup' %}
        {%- if form.posted_successfully? -%}
          <div class="form-success">You are on the list — we will email you the moment we open.</div>
        {%- else -%}
          <input type="hidden" name="contact[tags]" value="coming-soon">
          <div class="inline-form">
            <input type="email" name="contact[email]" placeholder="you@example.com" aria-label="Email" required>
            <button class="btn" type="submit">Notify me</button>
          </div>
        {%- endif -%}
      {% endform %}

      <hr style="border:0;border-top:1px solid var(--line);margin:24px 0">

      {% form 'storefront_password' %}
        {%- if form.errors -%}<div class="form-error">Wrong password, try again.</div>{%- endif -%}
        <label class="field"><span>Have a password?</span>
          <input type="password" name="password" placeholder="Enter store password">
        </label>
        <button class="btn btn--secondary btn--full" type="submit">Enter the store</button>
      {% endform %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something surprising is coming" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Mystery Flower Box is opening soon. Leave your email and be first through the door.</p>" }
  ]
}
{% endschema %}
