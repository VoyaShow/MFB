{%- if section.blocks.size > 0 -%}
  <div class="announcement">
    {%- for block in section.blocks limit: 1 -%}
      <span {{ block.shopify_attributes }}>
        {{ block.settings.text }}
        {%- if block.settings.link_text != blank and block.settings.link != blank %}
          <a href="{{ block.settings.link }}">{{ block.settings.link_text }}</a>
        {%- endif -%}
      </span>
    {%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free UK delivery on every box over £35 🌸" },
        { "type": "text", "id": "link_text", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Announcement bar", "blocks": [{ "type": "message" }] }]
}
{% endschema %}
